# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production-REQUIRED

# Database
DATABASE_URL=sqlite:///mental_health.db
# For PostgreSQL: postgresql://user:password@localhost:5432/mental_health_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=jwt-secret-change-in-production-REQUIRED
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# AI Provider Configuration
AI_PROVIDER=gemini
# Options: gemini, openai, anthropic, groq, local

# API Keys (get from respective providers)
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# AI Model Settings
AI_MODEL_NAME=gemini-1.5-pro
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048
AI_STREAMING=True

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
MAIL_FROM=noreply@mentalhealth.app

# Crisis Settings
CRISIS_KEYWORDS=suicide,kill myself,end my life,self-harm,cut myself,overdose
CRISIS_HOTLINE_US=988
CRISIS_HOTLINE_INTERNATIONAL=+1-800-273-8255
ADMIN_ALERT_EMAIL=admin@mentalhealth.app

# Twilio (Optional - for SMS alerts)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_DEFAULT=100 per hour

# Uploads
UPLOAD_FOLDER=uploads
MAX_UPLOAD_SIZE=5242880

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Vector DB
VECTOR_DB_TYPE=chroma
VECTOR_DB_PATH=./chroma_db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
